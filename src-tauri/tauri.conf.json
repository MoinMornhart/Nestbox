{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nestbox",
  "version": "0.9.1",
  "identifier": "app.nestbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nestbox",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Nestbox",
    "shortDescription": "Virtuelle Maschinen einfach gemacht",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["German"], "displayLanguageSelector": false },
      "wix": { "language": "de-DE" }
    }
  }
}
